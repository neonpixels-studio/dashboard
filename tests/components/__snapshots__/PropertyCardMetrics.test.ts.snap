       the last known state" behavior for the overview rollups. -->
<div data-v-8da57ad3="" data-v-c0c351bf="" class="metrics-skeleton">
  <ul data-v-8da57ad3="" class="stats-skeleton">
    <li data-v-8da57ad3="" class="stat-skeleton">
      <skeletonblock data-v-8da57ad3="" width="36px" height="8px"></skeletonblock>
