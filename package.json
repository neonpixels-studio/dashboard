{
  "name": "dashboard",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "dev": "TMPDIR=/tmp dotenvx run -f .env -- nuxt dev",
    "dev:test": "TMPDIR=/tmp nuxt dev",
    "build": "dotenvx run -f .env.production -- nuxt build",
    "build:dev": "dotenvx run -f .env.dev -- nuxt build",
    "preview": "dotenvx run -f .env.production -- nuxt preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run",
    "lint": "prettier --check . && eslint . && fallow audit",
    "lint:ci": "prettier --check . && eslint . && fallow audit --base origin/${BASE_BRANCH:-main}",
    "lint:fix": "prettier --write . && eslint . --fix && fallow fix --yes",
    "typecheck": "nuxt prepare && tsc -p .nuxt/tsconfig.server.json --noEmit",
    "prepare": "husky",
    "db:generate": "dotenvx run -f .env -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env -- drizzle-kit migrate",
    "db:migrate:production": "dotenvx run -f .env.production -- drizzle-kit migrate",
    "db:push": "dotenvx run -f .env -- drizzle-kit push",
    "db:studio": "dotenvx run -f .env -- drizzle-kit studio",
    "db:seed": "dotenvx run -f .env -- tsx server/db/seed.ts",
    "e2e": "dotenvx run -f .env.e2e -- playwright test",
    "e2e:headed": "dotenvx run -f .env.e2e -- playwright test --headed",
    "e2e:ui": "dotenvx run -f .env.e2e -- playwright test --ui",
    "e2e:debug": "dotenvx run -f .env.e2e -- playwright test --debug",
    "e2e:report": "playwright show-report e2e/report"
  },
  "dependencies": {
    "@clerk/nuxt": "^3.1.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@pinia/nuxt": "^0.11.3",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "stripe": "^22.6.2",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.36",
    "@dotenvx/dotenvx": "^1.75.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "fallow": "^2.96.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "prettier": "^3.9.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1"
  }
}
