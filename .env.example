# Reference of every runtime env var the app reads. Real values are NOT kept
# here — they live ENCRYPTED in the committed dotenvx files:
#   .env             local dev          (key: DOTENV_PRIVATE_KEY)
#   .env.dev         Netlify previews   (key: DOTENV_PRIVATE_KEY_DEV)
#   .env.e2e         e2e tests / CI     (key: DOTENV_PRIVATE_KEY_E2E)
#   .env.production  Netlify production (key: DOTENV_PRIVATE_KEY_PRODUCTION)
#
# Set a value:     npx dotenvx set VAR "value" -f .env[.dev|.e2e|.production]
# Read decrypted:  npx dotenvx get -f .env
# Private keys land in .env.keys (gitignored). Back it up to your password
# manager — without it the encrypted files cannot be decrypted.

# Neon DB connection string — https://console.neon.tech → your project →
# Connection Details. Read into runtimeConfig.databaseUrl at build time, and by
# the drizzle-kit CLI (db:generate, db:migrate, db:push, db:studio).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Overrides DATABASE_URL when set — .env.e2e ONLY, so e2e runs never touch the
# dev database. Point it at a dedicated Neon branch.
E2E_DATABASE_URL=

# Clerk — https://dashboard.clerk.com → API Keys
# The publishable key ships to the browser; the secret key must not.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NUXT_CLERK_SECRET_KEY=sk_test_...

# Disable new user sign-ups (optional). When "true", existing users keep working
# but a newly-authenticated Clerk identity is rejected with a 403 instead of
# being registered. Read via runtimeConfig, so it bakes into the build — set it
# only in the environment you want it in. Leave empty to allow sign-ups.
NUXT_DISABLE_SIGNUPS=

# --- Per-app Clerk secret keys ------------------------------------------------
# Each property (basin, markpost, wanderist, ...) has its own Clerk app. These
# read that app's user/session data for the dashboard (auth to *this* app still
# uses NUXT_CLERK_SECRET_KEY above). Same source as above: that property's
# Clerk dashboard -> API Keys -> Secret key.
NUXT_CLERK_SECRET_KEY_BASIN=sk_test_...
NUXT_CLERK_SECRET_KEY_MARKPOST=sk_test_...
NUXT_CLERK_SECRET_KEY_WANDERIST=sk_test_...

# --- Google Analytics 4 -------------------------------------------------------
# Service account credentials for the GA4 Data API. Create one at
# https://console.cloud.google.com -> IAM & Admin -> Service Accounts, grant it
# "Viewer" on each GA4 property (Admin -> Property Access Management in GA),
# then download its JSON key. Paste the two fields below rather than the whole
# JSON file so they sit alongside the rest of these vars.
NUXT_GA4_SA_CLIENT_EMAIL=ga4-reader@some-project.iam.gserviceaccount.com
# dotenvx expands the literal \n into real newlines when this is double-quoted.
# If a consumer ever reads this key from a host that doesn't (e.g. a plain
# process.env passthrough, some CI secret stores), it must call
# .replace(/\\n/g, "\n") on the value before handing it to the GA4 client, or
# PEM parsing fails.
NUXT_GA4_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GA4 property IDs — GA Admin -> Property Settings -> Property ID (the numeric
# ID, not the measurement ID). One per property the dashboard reports on.
NUXT_GA4_PROPERTY_ID_BASIN=
NUXT_GA4_PROPERTY_ID_MARKPOST=
NUXT_GA4_PROPERTY_ID_WANDERIST=
NUXT_GA4_PROPERTY_ID_DANHOLLORAN=
NUXT_GA4_PROPERTY_ID_GRIMICORN=
NUXT_GA4_PROPERTY_ID_NEONPIXELS=

# --- Stripe --------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys -> Secret key. One Stripe account shared
# across properties; product IDs below scope revenue stats to each property.
NUXT_STRIPE_SECRET_KEY=sk_live_...

# Product IDs — https://dashboard.stripe.com/products -> the product -> ID
# (prod_...). Used to filter subscriptions/charges per property.
NUXT_STRIPE_PRODUCT_ID_BASIN=
NUXT_STRIPE_PRODUCT_ID_MARKPOST=
NUXT_STRIPE_PRODUCT_ID_WANDERIST=

# --- Sentry ----------------------------------------------------------------
# Auth token — https://sentry.io/settings/account/api/auth-tokens/, needs
# `project:read` and `org:read` scopes to query issue counts via the API.
NUXT_SENTRY_AUTH_TOKEN=
# Org slug — https://sentry.io/settings/ (the slug in the URL after /settings/).
NUXT_SENTRY_ORG=
# Per-property project slugs — Sentry -> that project -> Settings -> the slug
# in the URL (sentry.io/organizations/<org>/projects/<slug>/).
NUXT_SENTRY_PROJECT_BASIN=
NUXT_SENTRY_PROJECT_MARKPOST=
NUXT_SENTRY_PROJECT_WANDERIST=

# --- Blog platforms (markpost publishing targets) -----------------------------
# Hashnode — https://hashnode.com/settings/developer -> Generate a Personal
# Access Token. Publication ID is on the blog dashboard -> Settings -> General
# (or via the GraphQL API `me { publications }`).
NUXT_HASHNODE_TOKEN=
NUXT_HASHNODE_PUBLICATION_ID=

# DEV.to — https://dev.to/settings/extensions -> DEV API Keys -> Generate API Key.
NUXT_DEVTO_API_KEY=

# Medium — Medium retired its own publish API, so this reads via RapidAPI's
# unofficial Medium API (https://rapidapi.com/nishujain199719-vgIfuFHxLd0/api/medium2).
# Subscribe there for the key; the username is the plain @handle to read stats for.
NUXT_MEDIUM_RAPIDAPI_KEY=
NUXT_MEDIUM_USERNAME=

# --- Per-app secret encryption -------------------------------------------------
# Symmetric key for encrypting per-app integration overrides (see the
# `integration_config` table, added separately) before they're stored in the
# database — shared studio keys above stay in env; per-app overrides live
# encrypted in the DB, decrypted with this key at read time via
# server/utils/integrationSecrets.ts. Base64-encoded 32 bytes (AES-256-GCM).
# Generate one with: openssl rand -base64 32
# Rotating this key orphans any secrets already encrypted with the old one —
# re-encrypt them (or have integrations re-authenticate) after a rotation.
NUXT_INTEGRATION_ENCRYPTION_KEY=

# Shared secret the sibling apps present when triggering an on-demand
# dashboard sync (e.g. "a new subscription happened, refresh Stripe now"
# instead of waiting for the next poll). Generate with: openssl rand -hex 32
NUXT_SYNC_TRIGGER_SECRET=
